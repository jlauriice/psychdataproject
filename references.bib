@article{golbeck2024,
  title={A Dataset for The Study of Online Radicalization Through Incel Forum Archives},
  author={Golbeck, Jennifer},
  journal={Journal of Quantitative Description: Digital Media},
  volume={1},
  pages={1--29},
  year={2024},
  doi={10.51685/jqd.2024.004},
  note={This article introduces a large dataset containing 9.2 million posts from five online incel communities between 2016 and 2023 and demonstrates how computational text analysis can be used to examine changes in incel-specific language over time as a potential marker of radicalization. The source is a peer-reviewed academic article and provides detailed information about the dataset's collection, structure, and limitations, although the authors note that some online communities are not represented and that using incel-specific language as a proxy for radicalization may not capture the full complexity of radicalization. This source is directly relevant to my project because it provides the incels.is dataset I am using and offers a methodological example for analyzing language patterns over time to study online radicalization.}
}

@article{ozer2018,
  title={Capturing violent radicalization: Developing and validating scales measuring central aspects of radicalization},
  author={Ozer, Simon and Bertelsen, Preben},
  journal={Scandinavian Journal of Psychology},
  volume={59},
  pages={653--660},
  year={2018},
  doi={10.1111/sjop.12484},
  note={This article develops and validates two psychological scales for measuring central aspects of radicalization: extremist attitudes and acceptance of violence or illegal acts. Using data from 686 Danish and U.S. participants, the authors found that the scales had strong psychometric properties and showed acceptable cross-cultural equivalence. The source is a strong academic source because it uses established psychological measurement and factor analysis to develop and validate the scales, although the sample was limited to mostly Western late-teen participants, which limits how broadly the measures can be generalized. The authors also note that the scales do not capture the full specificity of radicalization processes. This source informs my project by providing a psychological framework for distinguishing extremist attitudes from acceptance of violence and by showing how radicalization can be operationalized and measured. It could help me think about how patterns of language in online communities might relate to different psychological aspects of radicalization rather than treating all extremist content as equivalent.}
}

@article{ozer2019,
  title={Countering Radicalization: An Empirical Examination From a Life Psychological Perspective},
  author={Ozer, Simon and Bertelsen, Preben},
  journal={Peace and Conflict: Journal of Peace Psychology},
  volume={25},
  number={3},
  pages={211--225},
  year={2019},
  doi={10.1037/pac0000394},
  note={This article examines radicalization through the Life Psychology framework, which proposes that insecure life attachment and deficiencies in general life skills can contribute to extremist attitudes and acceptance of violent or illegal means. Using samples of 686 students from the United States and Denmark, the authors developed and tested measures of life attachment and life skills and found preliminary support for the idea that deficient life skills can strengthen the relationship between insecure life attachment and extremist attitudes and acceptance of violence. The source is a strong academic source because it uses established psychological measurement, factor analysis, and moderation analyses, although the participants were primarily young students from two Western countries, limiting the generalizability of the findings. The authors also describe the results as preliminary and note that longitudinal research is needed to better examine radicalization processes. This source informs my project by providing a psychological explanation for why people may become more receptive to extremist ideas and by highlighting factors such as insecurity, belonging, community participation, perspective-taking, and life skills. These concepts could help me interpret patterns in online extremist communities and think about how psychological factors might relate to changes in extremist language or engagement over time.}
}

@article{kunst2026,
  title={Intelligent Systems, Vulnerable Minds: A Framework for Radicalization to Violence in the Age of AI},
  author={Kunst, Jonas R. and Obaidi, Milan and Gollwitzer, Anton and Brandtz{\ae}g, Petter B. and Hinrichs, Yannic and Saini, Neha and Schroeder, Daniel T.},
  journal={Personality and Social Psychology Review},
  volume={30},
  number={3},
  pages={395--426},
  year={2026},
  doi={10.1177/10888683261430089},
  note={This review proposes a four-stage framework for understanding how AI and online environments may interact with psychological processes involved in radicalization to violence: Exposure, Reinforcement, Group Integration, and Violent Extremist Action. The authors argue that recommender systems, algorithmic amplification, filter bubbles, and generative AI can interact with psychological factors such as negativity bias, confirmation bias, need for belonging, identity uncertainty, grievances, and the need for cognitive closure. The source is a strong academic source because it brings together research from psychology, computer science, communication, political science, and criminology, and it clearly distinguishes well-supported mechanisms from theoretical claims. However, it is a review and theoretical framework rather than a single empirical study, and the authors acknowledge that some proposed AI mechanisms, especially AI bot swarms and certain “algorithmic rabbit hole” effects, still need more empirical testing. The literature also relies heavily on Western and English-language research, which limits generalizability. This source is especially useful for my project because it provides a psychological framework for understanding online radicalization as a process that can develop over time. The four stages could help me think about how changes in language, engagement, and community participation in my incel and Stormfront datasets might reflect movement from exposure and reinforcement toward stronger ideological commitment, while also reminding me that online radicalization is not necessarily a linear or deterministic process.}
}

@article{jasko2017,
  title={Quest for Significance and Violent Extremism: The Case of Domestic Radicalization},
  author={Jasko, Katarzyna and LaFree, Gary and Kruglanski, Arie},
  journal={Political Psychology},
  volume={38},
  number={5},
  pages={815--831},
  year={2017},
  doi={10.1111/pops.12376},
  note={This article applies the quest for significance model of radicalization to individuals who committed ideologically motivated crimes in the United States. Using data from 1,496 individuals, the authors found that economic and social losses of significance were positively related to the use of violence, and that having radicalized friends was also associated with violence. The source is a strong academic source because it uses a large empirical sample and tests a specific psychological theory using data from PIRUS, although the observational data cannot establish that loss of significance directly causes radicalization or violence. This source is especially relevant to my project because I plan to use PIRUS and want to examine radicalization through a psychological lens. The concepts of social rejection, loss of significance, and radicalized social networks could also help me interpret patterns in my online incel data.}
}

@article{characteristicsincel2023,
  title={Characteristics of Incel Forum Users: Social Network Analysis and Chronological Posting Patterns},
  author={},
  journal={Journal of Policing, Intelligence and Counter Terrorism},
  year={2023},
  doi={10.1080/1057610X.2023.2208892},
  note={This article examines users of three online incel forums using social network analysis and chronological posting patterns. The authors find that users commonly discuss mental health and relationships and that participation in other hateful forums often predates participation in incel forums. The source is useful because it combines computational analysis with questions about online behavior and radicalization, although the study is based on online forum activity and cannot directly measure users' psychological states or establish causal pathways. This source informs my project by suggesting that radicalization may involve movement between different online communities rather than occurring within a single forum. It could help me investigate whether users in my incel dataset show changes in participation or engagement that resemble movement into or within extremist communities.}
}

@article{deroos2024angry,
  title={The Angry Echo Chamber: A Study of Extremist and Emotional Language Changes in Incel Communities Over Time},
  author={de Roos, Melissa S. and Veldhuizen-Ochodnic{\'a}nov{\'a}, Laura and Hanna, Alexis},
  journal={Journal of Interpersonal Violence},
  volume={39},
  number={21--22},
  pages={4573--4597},
  year={2024},
  doi={10.1177/08862605241239451},
  note={This study examines how anger, sadness, and violent-extremist language change over time in an online incel community. Using LIWC and an incel violent-extremism dictionary, the authors found that incel users were already relatively angry and used incel vocabulary when they joined the forum, with some increases early in participation that later flattened. The source is a useful empirical study because it uses longitudinal online language data and established linguistic measures, although the analysis focuses on a limited period and language cannot directly measure a person's psychological state or prove that forum participation causes radicalization. This source is directly relevant to my project because I am using incel forum data and am interested in psychological changes over time. It also gives me an important alternative explanation to consider: people may enter extremist communities with pre-existing grievances or attitudes rather than becoming radicalized entirely because of the community.}
}

@phdthesis{rousis2024,
  title={The Pilling Process: Significance Quest, Self-Verification, and Fusion in Online Incel Forums},
  author={Rousis, Gregory J.},
  school={University of South Florida},
  year={2024},
  note={This dissertation examines psychological processes that might contribute to identity fusion in online incel communities, focusing on significance quest, self-verification, and identity fusion. The study analyzes 1,097,841 posts from 4,711 users and uses longitudinal text analysis and residual dynamic structural equation modeling. The proposed relationships between significance quest, self-verification, and later identity fusion were not consistently supported, which is useful because it shows that theoretically plausible pathways may not appear clearly in online behavioral data. The source is especially valuable for my project because it directly connects psychological theories to longitudinal analysis of incel forum posts. Its main limitation is that it is a doctoral dissertation rather than a peer-reviewed journal article. It could help me identify psychological concepts and possible linguistic measures for analyzing my incel dataset while also reminding me not to assume that a particular radicalization pathway is supported by the data.}
}

@article{pettersson2025,
  title={Fatalism, Evolution, and Interpersonal Attractiveness: Psychological Theories and Emotions in Incels' Constructions of Ingroup Identity and Outgroup Hate},
  author={Pettersson, Katarina and Marveggio, Mark Daniel and Callaghan, Peta and Augoustinos, Martha},
  journal={European Journal of Social Psychology},
  volume={55},
  number={2},
  pages={342--356},
  year={2025},
  doi={10.1002/ejsp.3145},
  note={This study examines how psychological and evolutionary ideas are used in incel discussions to construct group identities and explain hostility toward outgroups. Using a critical discursive psychological analysis of more than 1,000 discussion threads from incels.is, the authors identify several forms of incel identity, including victimized and aggrieved identities, and show how ideas about fatalism, just-world beliefs, evolutionary psychology, and interpersonal attraction are used within these discussions. The source is a strong academic source because it uses a systematic qualitative approach and is published in a social psychology journal, although its focus on discourse and identity construction does not directly measure individual psychological traits or causal radicalization processes. This source informs my project by giving me specific psychological themes and concepts to look for in my incel data, particularly identity, grievance, fatalism, and ingroup/outgroup thinking.}
}

@article{deroos2026,
  title={The radicalisation loop: A layered linguistic model of disengagement and re-engagement in an incel forum},
  author={de Roos, Melissa S. and Caon, Giorgia},
  journal={Current Psychology},
  volume={45},
  number={4},
  pages={358},
  year={2026},
  doi={10.1007/s12144-025-08944-z},
  note={This study examines how patterns of engagement and disengagement in an incel forum relate to changes in affective and cognitive language. Using longitudinal linear mixed models and LIWC on 2,009,875 comments collected over six years, the authors compare users who permanently left, remained active, or left and later returned. The study identifies different linguistic trajectories across these groups, including changes in grievance, hostility, and social language. The source is a strong and highly relevant academic study because it uses a large longitudinal dataset and quantitative linguistic methods, although the language measures are indirect indicators of psychological processes and the study cannot establish that changes in forum participation cause changes in psychological states. This source is directly relevant to my project because it provides a model for analyzing how users' language changes across time and different patterns of engagement. It could help me think about whether users in my dataset become more extreme, remain stable, disengage, or return to the community.}
}

@article{kleinberg2021,
  title={The temporal evolution of a far-right forum},
  author={Kleinberg, Bennett and van der Vegt, Isabelle and Gill, Paul},
  journal={Journal of Computational Social Science},
  volume={4},
  pages={1--23},
  year={2021},
  doi={10.1007/s42001-020-00064-x},
  note={This article examines the temporal development of the Stormfront forum between 2001 and 2015, focusing on user activity and the prevalence and intensity of extremist language. The authors use time-series models and individual user analyses and find that forum engagement and extremist language changed in distinct periods rather than simply becoming continuously more extreme. The source is a strong academic source because it combines a large online dataset with quantitative temporal and user-level analyses, although the study is limited to one far-right forum and one historical time period. This source informs my project by providing a methodological example for studying changes in extremist language over time. It is especially relevant because I am considering Stormfront as an additional dataset and could compare its patterns with those in my incel data.}
}

@article{gregory2021,
  title={Finding uncommon ground: Extremist online forum engagement predicts integrative complexity},
  author={Gregory, Andrew L. and Piff, Paul K.},
  journal={PLoS ONE},
  volume={16},
  number={1},
  pages={e0245651},
  year={2021},
  doi={10.1371/journal.pone.0245651},
  note={This study examines whether engagement with the extremist Stormfront forum is associated with changes in integrative complexity, a measure of how much language reflects differentiated and balanced thinking. Using naturalistic language data from 1,891 users, the authors found that users who had posted more and been members longer tended to show lower integrative complexity, although the effects were small. The source is a strong academic source because it uses a large naturalistic dataset, quantitative linguistic measures, and statistical models that account for individual differences. However, the effect sizes were small and the study cannot establish that forum participation caused changes in cognition. This source is particularly useful for my project because it provides a psychological measure that can be estimated from online language rather than requiring direct psychological surveys. It gives me another possible way to analyze psychological patterns in my Stormfront or incel data beyond simply counting extremist or hateful words.}
}

@article{rodriguez2025,
  title={Deciphering the incels: A scoping review on empirical research},
  author={Rodr{\'i}guez, Reyes and Maldonado, Miguel A. and Moyano, Manuel},
  journal={Aggression and Violent Behavior},
  volume={85},
  pages={102093},
  year={2025},
  doi={10.1016/j.avb.2025.102093},
  note={This scoping review synthesizes empirical research on the incel subculture and identifies major research areas including language, ideology, psychosocial characteristics, violent behavior, radicalization, exit processes, and measurement. The authors reviewed 402 records and included 82 empirical studies, drawing attention to gaps such as limited longitudinal research, limited comparisons between violent and nonviolent incels, and underrepresentation of non-English contexts. The source is useful because it systematically reviews a large body of empirical literature and identifies both established findings and gaps in the field, although the quality and methods of the individual studies included in the review vary. This source informs my project by helping me understand the broader research landscape around incels and by identifying potential psychological variables and unanswered questions that I could investigate using my own longitudinal forum data.}
}